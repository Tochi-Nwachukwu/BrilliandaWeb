# Settings for connecting to the Brillianda API. Copy this file to .env.local and fill it in.
# .env.local stays on your computer (git ignores it). On Vercel, add the same names under
# Project Settings › Environment Variables. Nothing here starts with NEXT_PUBLIC_: browsers never
# call the API directly, they go through this app's /api (src/proxy.ts), which adds the secret.

# api: the screens that have backend endpoints use the API. Anything else (or nothing): every
# screen runs on sample data, as the browser tests do. Screens whose backend isn't built yet say
# "Not connected yet" when this is api.
DATA_SOURCE=

# Where the API runs. Server-only.
API_URL=

# The API's PROXY_SHARED_SECRET. Get it from the backend team privately; never commit it.
API_PROXY_SECRET=

# Only if schools live under a domain other than brillianda.com (a staging domain, say).
# ROOT_DOMAIN=

# Staging only, while it has no school subdomains: the API's own domain. Calls for a school are
# then sent as from <school>.<this> (their docs/frontend-integration.md, "Staging without school
# subdomains"), and each school's session is kept apart on our side.
# API_ROOT_DOMAIN=api-rouge-nine-18.vercel.app

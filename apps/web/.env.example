# Optional. Copy to apps/web/.env.local to change.
# In development, screens whose API isn't built yet use stand-in data (DECISIONS.md D-7).
# Set to false to call the real API for everything. Production builds never use stand-in data.
VITE_USE_MOCKS=true

# Optional. Where the Brillanda wordmark on the sign-in screens leads: the marketing site.
# Left unset, it leads to "/" of this app.
# VITE_SITE_URL=https://brillanda.example

# Optional. A production build that keeps the stand-in data and sample sign-in, for showing the
# app (e.g. on Vercel) before the API exists (DECISIONS.md D-17). Leave unset for a real release.
# VITE_DEMO=true

{
  "name": "brillianda",
  "version": "0.1.0",
  "private": true,
  "description": "Brillianda: school registry for Nigerian schools (front end). See docs/plan.md.",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter e2e e2e"
  },
  "dependencies": {
    "@brillianda/core": "workspace:*",
    "@brillianda/ui": "workspace:*",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3"
  }
}
